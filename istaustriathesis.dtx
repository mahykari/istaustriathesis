% \subsection{Layout}
% \label{sec:user:layout}
%
% Most of the data that is supplied with the commands of the previous sections is used to generate the front matter of the thesis.
% It consists of obligatory items such as the title page(s) and the statement of originality as well as optional items such as the acknowledgements or the abstract in different languages.
% In the remainder of this section, the available items of the front matter are given.
%
% \DescribeMacro{\addtitlepage}
% Used as |\addtitlepage|, it generates the title page. The necessary pieces of information have to be set beforehand (as described in Section~\ref{sec:user:data}). This command is usually used directly after |\begin{document}\frontmatter|.
%
% \DescribeMacro{\committeepage}
% Used as |\addstatementpage|, it generates the signature page of the committee. The necessary pieces of information have to be set beforehand (as described in Section~\ref{sec:user:data}). This command is usually used directly after |\addtitlepage|.
%
% \DescribeMacro{\addstatementpage}
% Used as |\addstatementpage|, it generates a page with the statement of originality and the copyright notice as well as the signature field of the author. The necessary pieces of information have to be set beforehand (as described in Section~\ref{sec:user:data}). This command is usually used directly after |\addcommitteepage|.
%
% \DescribeEnv{abstract}
% \DescribeEnv{abstract*}
% Used as |\begin{abstract}|\meta{text}|\end{abstract}|, this environment generates a chapter with the abstract. Use the starred version, i.e., |abstract*|, to remove the table of content entry of this environment.
%
% \DescribeEnv{acknowledgements}
% \DescribeEnv{acknowledgements*}
% Used as |\begin{acknowledgements}|\meta{text}|\end{acknowledgements}|, this environment generates a chapter with the acknowledgements. Use the starred version, i.e., |acknowledgements*|, to remove the table of content entry of this environment.
%
% \DescribeEnv{aboutauthor}
% \DescribeEnv{aboutauthor*}
% Used as |\begin{aboutauthor}|\meta{text}|\end{aboutauthor}|, this environment generates a chapter with information about the author. Use the starred version, i.e., |aboutauthor*|, to remove the table of content entry of this environment.
%
% \DescribeEnv{publicationlist}
% \DescribeEnv{publicationlist*}
% Used as |\begin{publicationlist}|\meta{text}|\end{publicationlist}|, this environment generates a chapter with the publication list used in the thesis as well as a description of the author's contributions to them. Use the starred version, i.e., |publicationlist*|, to remove the table of content entry of this environment. Individual citations of the publications can be added using the |\bibentry|\marg{bibid} command.
%
